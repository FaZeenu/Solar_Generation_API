generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Province {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  districts District[]
}

model District {
  id          Int              @id @default(autoincrement())
  name        String
  provinceId  Int
  province    Province         @relation(fields: [provinceId], references: [id])
  substations GridSubstation[]

  @@unique([name, provinceId])
}

model GridSubstation {
  id            Int                 @id @default(autoincrement())
  name          String
  districtId    Int
  district      District            @relation(fields: [districtId], references: [id])
  installations SolarInstallation[]

  @@unique([name, districtId])
}

model SolarInstallation {
  id           Int                 @id @default(autoincrement())
  name         String
  meterId      String              @unique
  substationId Int
  substation   GridSubstation      @relation(fields: [substationId], references: [id])
  readings     GenerationReading[]
}

model GenerationReading {
  id             Int               @id @default(autoincrement())
  installationId Int
  installation   SolarInstallation @relation(fields: [installationId], references: [id])
  timestamp      DateTime
  powerKw        Float
  energyKwh      Float
  voltage        Float

  @@index([installationId, timestamp])
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  role         String
  jurisdiction String
}
